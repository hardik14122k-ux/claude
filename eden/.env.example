# ---------------------------------------------------------------------------
# EDEN P0 environment. Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

EDEN_ENV=local
EDEN_REGION=ap-south-1            # India only (DPDP-aligned) — locked decision #9

# --- Database: ONE pooled application role (locked decision #10) -------------
# The app connects with a single low-privilege role; the tenant router sets
# search_path per request. The role must NOT own the schemas and must NOT
# have CREATE on eden_control (only the migration/provisioner role does).
EDEN_DB_DSN=postgresql+asyncpg://eden_app:CHANGE_ME@localhost:5432/eden
EDEN_DB_POOL_SIZE=20
EDEN_DB_MAX_OVERFLOW=10
EDEN_DB_POOL_TIMEOUT=10

# Privileged DSN used ONLY by Alembic + the schema provisioner (DDL).
EDEN_DB_ADMIN_DSN=postgresql+asyncpg://eden_owner:CHANGE_ME@localhost:5432/eden

# --- Keycloak (self-hosted) — locked decision #8 ----------------------------
EDEN_OIDC_ISSUER=https://auth.eden.example/realms/eden
EDEN_OIDC_JWKS_URL=https://auth.eden.example/realms/eden/protocol/openid-connect/certs
EDEN_OIDC_AUDIENCE=eden-api
EDEN_OIDC_ALGORITHMS=RS256
# Custom Keycloak claim that carries the verified active tenant UUID.
EDEN_OIDC_TENANT_CLAIM=eden_tenant
EDEN_OIDC_JWKS_TTL=3600

# --- Behaviour --------------------------------------------------------------
EDEN_FAIL_CLOSED=true             # tenant routing aborts the connection on any doubt
EDEN_LOG_LEVEL=INFO
