{
  "realm": "eden",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "EDEN platform operations. Grants tenants:provision + tenants:read via the PDP."
      },
      {
        "name": "consultancy_owner",
        "description": "Consultancy owner. Grants candidates:review, candidates:read, referrals:read, tenants:provision."
      },
      {
        "name": "consultancy_recruiter",
        "description": "Consultancy recruiter. Grants candidates:review, candidates:read, referrals:read."
      },
      {
        "name": "partner",
        "description": "Referral partner (bridge model). Grants referrals:create, referrals:read, recruitment:read — own referrals only."
      }
    ]
  },
  "clients": [
    {
      "clientId": "eden-cli",
      "name": "EDEN demo/dev CLI (password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "eden-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "eden-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "eden-tenant-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "eden_tenant",
            "claim.name": "eden_tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000001",
      "username": "owner@demo.eden",
      "email": "owner@demo.eden",
      "firstName": "Olive",
      "lastName": "Owner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["consultancy_owner", "platform_admin"],
      "attributes": { "eden_tenant": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000002",
      "username": "recruiter@demo.eden",
      "email": "recruiter@demo.eden",
      "firstName": "Rae",
      "lastName": "Recruiter",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["consultancy_recruiter"],
      "attributes": { "eden_tenant": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000003",
      "username": "partner@demo.eden",
      "email": "partner@demo.eden",
      "firstName": "Pat",
      "lastName": "Partner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["partner"],
      "attributes": { "eden_tenant": ["11111111-1111-1111-1111-111111111111"] }
    },
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000004",
      "username": "partner2@demo.eden",
      "email": "partner2@demo.eden",
      "firstName": "Perry",
      "lastName": "Partner-Two",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["partner"],
      "attributes": { "eden_tenant": ["11111111-1111-1111-1111-111111111111"] }
    }
  ]
}
